{
  "name": "c2pa-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "画像に埋め込まれたC2PA / Content Credentialsをブラウザ内だけで解析・検証して表示するツール",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "^0.13.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.0",
    "vitest": "^3.0.0"
  }
}
